# =========================================================================
# SHD M Supply System: Admin Dashboard Configuration
# =========================================================================

# REST API Backend Base URL (leave empty or set to Cloudflare Tunnel / local URL)
# Example for Cloudflare Tunnel: https://api.shd-supply.org
# Example for local backend: http://localhost:3001
API_BASE_URL=""

# Default display time zone (e.g. Asia/Bangkok, Asia/Yangon, UTC)
DEFAULT_TIMEZONE="Asia/Bangkok"

# Optional Cloudflare Tunnel token for Ubuntu zero-trust deployment
# CLOUDFLARE_TUNNEL_TOKEN=""

# GEMINI_API_KEY (Provided automatically in AI Studio runtime if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
